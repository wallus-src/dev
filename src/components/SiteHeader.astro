---
import { SITE_TITLE } from '../consts';
import { link } from '../utils/posts';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const rel = pathname.startsWith(base) ? `/${pathname.slice(base.length)}` : pathname;
const current = (href: string) => (href === '/' ? rel === '/' : rel.startsWith(`${href}/`) || rel === href);
---

<header class="site-header">
	<div class="shell">
		<a href={link('/')} class="wordmark" aria-label={SITE_TITLE}>{SITE_TITLE}<span class="mark">*</span></a>
		<nav class="site-nav" aria-label="Site">
			<a href={link('/blog')} aria-current={current('/blog') ? 'page' : undefined}>Writing</a>
			<a href={link('/tags')} aria-current={current('/tags') ? 'page' : undefined}>Topics</a>
			<a href={link('/about')} aria-current={current('/about') ? 'page' : undefined}>About</a>
		</nav>
		<div class="header-actions">
			<button class="icon-btn search-trigger" type="button" aria-label="Search" data-open-search>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7" />
					<path d="m20 20-3.5-3.5" />
				</svg>
				<span class="kbd">⌘K</span>
			</button>
			<ThemeToggle />
		</div>
	</div>
</header>
